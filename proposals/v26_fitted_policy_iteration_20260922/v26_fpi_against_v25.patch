+    "population_scale",
+    "hazard_source_scale",
+)
+SCENARIO_POPULATION_HALF_SCALE = 10_000.0
+SCENARIO_HAZARD_HALF_SCALE = 3.0
+
+
+def scenario_descriptor(population: float, hazards: float, panic_rate: float) -> np.ndarray:
+    """Return the bounded scenario descriptors in ``SCENARIO_FEATURE_NAMES`` order."""
+    p = max(0.0, float(population))
+    h = max(0.0, float(hazards))
+    k = min(1.0, max(0.0, float(panic_rate)))
