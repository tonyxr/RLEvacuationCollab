{
  "schema_version": 2,
  "suite_id": "urban_shelter_priority_e0_e6_v3",
  "description": "Confirmatory and mechanism experiment suite for hierarchical regional shelter-capacity decisions under stochastic urban hazards.",
  "city_profiles": "city_profiles.json",
  "confirmatory_analysis": {
    "policy_seeds": 8,
    "train_episodes_per_city": 120,
    "bootstrap_draws": 20000,
    "confidence_level": 0.95,
    "primary_metric": "objective_episode_return",
    "primary_comparison": "rl_minus_heuristic",
    "city_weighting": "equal_city_macro_average"
  },
  "evaluation_factorial": {
    "factors": {
      "capacity_regime": [
        "scarce",
        "moderate",
        "ample"
      ],
      "hazard_regime": [
        "low",
        "moderate",
        "severe"
      ],
      "demand_pattern": [
        "dispersed",
        "clustered"
      ]
    },
    "replications_per_factor_cell": 5
  },
  "scale_stress_design": {
    "population_levels": [
      10000,
      20000,
      30000,
      40000,
      50000
    ],
    "shelter_candidate_levels": [
      25,
      50,
      75,
      100,
      125
    ],
    "horizon_timesteps": 60,
    "shelter_action_interval": 2,
    "replications_per_cell": 5
  },
  "experiments": {
    "E0": {
      "title": "Scenario calibration and feasibility",
      "research_question": "Do the factorial scenarios span nontrivial but feasible evacuation conditions without floor or ceiling effects?",
      "design": {
        "policies": [
          "no_dynamic_deployment"
        ],
        "use": "calibration_only_not_policy_selection",
        "checks": [
          "initial_capacity_coverage",
          "feasible_region_fraction",
          "hazard_exposure",
          "outcome_floor_ceiling"
        ]
      },
      "outputs": [
        "scenario_calibration"
      ]
    },
    "E1": {
      "title": "Primary RL efficacy",
      "research_question": "Does the learned regional-priority policy improve the simple evacuation objective over the active-population heuristic?",
      "design": {
        "policies": [
          "rl",
          "heuristic"
        ],
        "pairing": "common_random_numbers_within_city_factor_cell",
        "training": "balanced_pooled_five_city_ppo",
        "estimand": "equal_city_macro_mean_rl_minus_heuristic"
      },
      "outputs": [
        "training_summary",
        "evaluation_summary",
        "checkpoint_evaluation"
      ]
    },
    "E2": {
      "title": "Sequential versus static placement",
      "research_question": "What is gained by adaptive sequential regional prioritization relative to random online and static predeployment policies?",
      "design": {
        "policies": [
          "rl",
          "risk_reduction",
          "heuristic",
          "hazard_weighted",
          "accessibility_deficit",
          "random",
          "static_greedy",
          "rl_precommit",
          "initial_only"
        ],
        "comparability": "dynamic_policies_share_observation_mask_budget_cadence_and_lower_level_executor; static and precommit policies are separately labeled timing controls",
        "factorial": "full_capacity_by_hazard_by_demand"
      },
      "outputs": [
        "regime_evaluation",
        "map_figure_index"
      ]
    },
    "E3": {
      "title": "Hierarchical action scalability",
      "research_question": "Does regional prioritization preserve decision quality while avoiding the candidate-level action-space and latency growth?",
      "design": {
        "methods": [
          "hierarchical_region",
          "flat_candidate"
        ],
        "outcomes": [
          "decision_latency_ms",
          "action_count",
          "episode_return"
        ],
        "scope": "matched_small_and_medium_instances_where_both_methods_are_computable"
      },
      "outputs": [
        "scalability_evaluation"
      ]
    },
    "E4": {
      "title": "Reward and architecture ablation",
      "research_question": "Which parsimonious objective terms and hierarchical policy components account for learned performance?",
      "design": {
        "ablations": [
          "full_model",
          "no_risk_person_time",
          "no_casualty_priority",
          "no_heuristic_residual_prior",
          "no_neighbor_message",
          "flat_candidate_action"
        ],
        "comparison": "paired_against_full_model_on_identical_scenarios",
        "selection_rule": "no_post_hoc_reward_weight_tuning_on_confirmatory_scenarios"
      },
      "outputs": [
        "ablation_evaluation"
      ]
    },
    "E5": {
      "title": "Cross-city transfer",
      "research_question": "Does the learned regional decision rule transfer to an unseen city without a city identifier?",
      "design": {
        "protocol": "leave_one_city_out",
        "models": [
          "pooled_all_cities",
          "leave_one_city_out",
          "heuristic"
        ],
        "held_out_units": "each_of_five_cities",
        "no_target_city_finetuning": true
      },
      "outputs": [
        "transfer_evaluation"
      ]
    },
    "E6": {
      "title": "Robustness to operating uncertainty",
      "research_question": "Is the policy advantage stable under demand, hazard, map, and shelter-capacity perturbations not used for policy selection?",
      "design": {
        "perturbations": [
          "demand_shift",
          "hazard_intensity_shift",
          "hazard_location_shift",
          "shelter_capacity_error",
          "candidate_availability_loss"
        ],
        "comparison": "rl_minus_heuristic",
        "analysis": "paired_effect_by_perturbation_and_level"
      },
      "outputs": [
        "robustness_evaluation",
        "scale_stress_evaluation"
      ]
    }
  },
