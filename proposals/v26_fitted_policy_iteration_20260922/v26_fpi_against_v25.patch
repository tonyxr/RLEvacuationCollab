+def accrued_tokens(t: int, *, first: int, interval: int, budget: int) -> int:
+    """Deployment authorizations accrued by timestep ``t`` (token bucket).
+
+    One capacity token is authorized at every scheduled epoch
+    ``first + k * interval``; the count never exceeds the budget.
+    """
+    t, first, interval, budget = int(t), int(first), int(interval), int(budget)
+    if interval <= 0:
+        raise ValueError("interval must be positive")
+    if t < first or budget <= 0:
+        return 0
+    return min(budget, (t - first) // interval + 1)
+
+
+def next_scheduled_epoch(t: int, *, first: int, interval: int) -> int:
+    """The first scheduled epoch strictly after timestep ``t``."""
+    t, first, interval = int(t), int(first), int(interval)
+    if interval <= 0:
+        raise ValueError("interval must be positive")
+    if t < first:
+        return first
+    return first + interval * ((t - first) // interval + 1)
+
+
+def decision_due(
+    t: int,
+    *,
+    first: int,
+    interval: int,
+    budget: int,
+    deployed: int,
+    catch_up: bool,
