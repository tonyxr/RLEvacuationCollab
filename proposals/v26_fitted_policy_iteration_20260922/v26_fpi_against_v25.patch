+            "nmcc_fpi_episode_labelled_states": float(summary.get("labelled_states", 0.0)),
+            "nmcc_fpi_episode_exhaustive_states": float(summary.get("exhaustive_states", 0.0)),
+            "nmcc_fpi_episode_branched_mean": float(summary.get("branched_mean", 0.0)),
+            "nmcc_fpi_episode_greedy_gain": float(summary.get("greedy_gain", 0.0)),
+            "nmcc_fpi_episode_greedy_gain_normalized": (
+                float(summary.get("greedy_gain", 0.0)) / scale
+                if np.isfinite(scale) and scale > 0.0
+                else float("nan")
+            ),
+            "nmcc_fpi_episode_executed_gain": float(summary.get("executed_gain", 0.0)),
+            "nmcc_fpi_episode_greedy_regret": float(summary.get("greedy_regret", float("nan"))),
+            "nmcc_fpi_episode_base_regret": float(summary.get("base_regret", float("nan"))),
+            "nmcc_fpi_episode_label_seconds": float(label_seconds),
+            "nmcc_fpi_episode_branch_steps": float(branch_steps),
+            "nmcc_fpi_deployed_lambda": float(self.fpi_lambda),
+            "nmcc_fpi_deployed_beta": float(self.fpi_beta),
+            "nmcc_fpi_refit_index": float(self.fpi_refits),
+        }
+
+    def _fpi_load_frames(self, store: FPI.LabelStore, episode_id: str) -> dict:
+        path = store.frames_path(episode_id)
+        try:
+            payload = torch.load(path, map_location="cpu", weights_only=False)
+        except TypeError:
+            payload = torch.load(path, map_location="cpu")
+        if not isinstance(payload, dict) or "transitions" not in payload:
+            raise ValueError(f"Label-store frames {path} are malformed")
+        if list(payload.get("global_features", [])) != list(self.global_feature_names):
+            raise ValueError(f"Label-store frames {path} use another global-feature schema")
+        return payload
+
+    def _fpi_sequences(
+        self, store: FPI.LabelStore, episodes: Sequence[FPI.EpisodeLabels]
+    ) -> list[FpiSequence]:
+        """Stored episodes as replayable recurrent sequences, in input order."""
+        sequences = []
+        for episode in episodes:
+            key = (
+                store.frames_path(episode.episode_id),
+                os.path.getmtime(store.frames_path(episode.episode_id)),
+                os.path.getmtime(store.labels_path(episode.episode_id)),
+            )
+            cached = self._fpi_sequence_cache.get(key)
+            if cached is not None:
+                sequences.append(cached)
+                continue
+            payload = self._fpi_load_frames(store, episode.episode_id)
+            transitions = payload["transitions"]
+            positions: list[int] = []
+            cumulative = []
+            total = 0
+            for history in transitions:
+                if not history:
+                    raise ValueError("A stored transition has no observation frames")
+                total += len(history)
+                cumulative.append(total - 1)
+            for label in episode.decisions:
+                if not 0 <= label.transition_index < len(transitions):
+                    raise ValueError("A stored label refers to a missing transition")
+                positions.append(cumulative[label.transition_index])
+            last = positions[-1]
+            frames = []
+            for history in transitions:
+                for item in history:
+                    if len(frames) > last:
+                        break
+                    # Cached on the CPU; moved to the device one minibatch at
+                    # a time in _packed_graph.
+                    frame = self._deserialize_frame(item, device="cpu")
+                    self._validate_frame(frame)
+                    frames.append(frame)
+            if len(frames) != last + 1:
+                raise ValueError("Stored frames end before the last labelled decision")
+            for label, position in zip(episode.decisions, positions):
+                mask = frames[position].action_mask.detach().cpu().numpy().astype(bool)
+                if not np.array_equal(mask, label.feasible):
+                    raise ValueError("A stored label's feasible set disagrees with its frame")
+            sequence = FpiSequence(
+                episode_id=episode.episode_id,
+                family_key=episode.family.key,
+                split=episode.split,
+                frames=frames,
+                edge_index=torch.as_tensor(payload["edge_index"], dtype=torch.long),
+                decision_positions=positions,
+                labels=list(episode.decisions),
+            )
+            self._fpi_sequence_cache[key] = sequence
+            sequences.append(sequence)
+        return sequences
+
+    def _packed_graph(self, frames: Sequence[ObservationFrame], edge_indices) -> GNNInput:
+        """Pack one frame per episode into a batched graph with explicit offsets.
+
+        ``fit_gnn``'s template heuristic is bypassed on purpose: when every
+        route edge of a batch happens to lie in the first graph it would
+        replicate them into the others.  Offsets here are exact by
+        construction.
+        """
+        device = self.device
+        counts = [int(frame.cell_features.shape[0]) for frame in frames]
+        offsets = np.concatenate(([0], np.cumsum(counts[:-1]))).astype(np.int64)
+        cells = torch.cat([frame.cell_features for frame in frames], dim=0).to(device)
+        edges = torch.cat(
+            [edge.to(device) + int(offset) for edge, offset in zip(edge_indices, offsets)], dim=1
+        )
+        routes = torch.cat(
+            [
+                frame.route_edge_index.to(device) + int(offset)
+                for frame, offset in zip(frames, offsets)
+            ],
+            dim=1,
+        )
+        weights = torch.cat([frame.route_edge_weight for frame in frames], dim=0).to(device)
+        batch = torch.repeat_interleave(
+            torch.arange(len(frames), device=device),
+            torch.as_tensor(counts, device=device),
+        )
+        return GNNInput(
+            x_ped=cells[:, PED_FEATURE_SLICE],
+            x_hazard=cells[:, HAZARD_FEATURE_SLICE],
+            x_infra=cells[:, INFRA_FEATURE_SLICE],
+            x_global=torch.stack([frame.global_features for frame in frames], dim=0).to(device),
+            edge_index=edges,
+            route_edge_index=routes,
+            route_edge_weight=weights,
+            batch=batch,
+            candidate_cell_index=torch.stack(
+                [frame.candidate_cell_index for frame in frames], dim=0
+            ).to(device),
+            candidate_features=torch.stack(
+                [frame.candidate_features for frame in frames], dim=0
+            ).to(device),
+        )
+
+    def _fpi_forward(self, sequences: Sequence[FpiSequence]) -> dict:
+        """Batched recurrent replay; outputs at every labelled decision.
+
+        Episodes are advanced in lock step, longest first, so the active set
+        at step ``k`` is always a prefix and the LSTM state is a slice of the
+        previous step's output.  Returns flat tensors over all labelled
+        decisions and ``index`` = ``(sequence, label)`` pairs in the same
+        order.
+        """
+        order = sorted(range(len(sequences)), key=lambda i: -len(sequences[i].frames))
+        ordered = [sequences[i] for i in order]
+        wanted = [
+            {position: label for label, position in enumerate(sequence.decision_positions)}
+            for sequence in ordered
+        ]
+        policy = self._require_policy()
+        samples, priors, naturals, causals, index = [], [], [], [], []
+        state = None
+        longest = len(ordered[0].frames) if ordered else 0
+        for step in range(longest):
+            active = sum(1 for sequence in ordered if len(sequence.frames) > step)
+            frames = [ordered[row].frames[step] for row in range(active)]
+            graph = self._packed_graph(frames, [ordered[row].edge_index for row in range(active)])
+            momentum = torch.stack([frame.momentum_features for frame in frames], dim=0).to(
+                self.device
+            )
+            if state is not None:
+                state = (state[0][:active], state[1][:active])
+            output = policy.forward_nmcc_recurrent(
+                graph,
+                state,
+                momentum,
+                uncertainty_penalty=self.nmcc_uncertainty_penalty,
+            )
+            state = output.recurrent_state
+            rows = [row for row in range(active) if step in wanted[row]]
+            if rows:
+                if output.improvement_value_samples is None or output.prior_logits is None:
+                    raise RuntimeError("Policy did not produce the fitted-value outputs")
+                selector = torch.as_tensor(rows, dtype=torch.long, device=self.device)
+                samples.append(output.improvement_value_samples.index_select(0, selector))
+                priors.append(output.prior_logits.index_select(0, selector))
+                naturals.append(output.natural_outcomes.index_select(0, selector))
+                causals.append(output.causal_outcome_samples.index_select(0, selector))
+                index.extend((order[row], wanted[row][step]) for row in rows)
+        if not index:
+            return {"index": []}
+        return {
+            "index": index,
+            "samples": torch.cat(samples, dim=0),
+            "prior": torch.cat(priors, dim=0),
+            "natural": torch.cat(naturals, dim=0),
+            "causal": torch.cat(causals, dim=0),
+        }
+
+    def _fpi_targets(
+        self,
+        sequences: Sequence[FpiSequence],
+        index: Sequence[tuple[int, int]],
+        scales: FPI.FamilyScales,
+        *,
+        bootstrap: bool,
+    ) -> dict:
+        """Label tensors aligned with ``_fpi_forward``'s ``index`` order."""
+        members = int(self.nmcc_ensemble_size)
+        rows = len(index)
+        actions = int(self.num_candidate_actions)
+        target = np.zeros((rows, actions), dtype=np.float32)
+        mask = np.zeros((rows, actions), dtype=np.float32)
+        weight = np.ones((rows, members), dtype=np.float32)
+        natural = np.zeros((rows, len(NMCC_OUTCOME_NAMES)), dtype=np.float32)
+        natural_valid = np.zeros(rows, dtype=np.float32)
+        effect = np.zeros((rows, actions, len(NMCC_OUTCOME_NAMES)), dtype=np.float32)
+        for row, (sequence_index, label_index) in enumerate(index):
+            sequence = sequences[sequence_index]
+            label = sequence.labels[label_index]
+            branched = label.branched
+            if int(branched.sum()) < 2:
+                continue
+            scale = scales.scale(sequence.family_key)
+            values = label.mean_values()
+            target[row, branched] = (values[branched] / scale).astype(np.float32)
+            mask[row, branched] = 1.0
+            if bootstrap:
+                weight[row] = FPI.bootstrap_weights(
+                    sequence.episode_id, label.decision_index, members
+                ).astype(np.float32)
+            wait = label.natural_outcome()
+            if np.all(np.isfinite(wait)):
+                natural[row] = wait
+                natural_valid[row] = 1.0
+                effects = label.outcome_effects()
+                effect[row, branched] = np.nan_to_num(effects[branched], nan=0.0)
+        def tensor(array):
+            return torch.as_tensor(array, dtype=torch.float32, device=self.device)
+        return {
+            "target": tensor(target),
+            "mask": tensor(mask),
+            "weight": tensor(weight),
+            "natural": tensor(natural),
+            "natural_valid": tensor(natural_valid),
+            "effect": tensor(effect),
+        }
+
+    @staticmethod
+    def _fpi_value_loss(samples: torch.Tensor, targets: dict) -> torch.Tensor:
+        """Bootstrap-weighted within-state Huber loss in family-normalized units.
+
+        Predictions and labels are both centered on their mean over the
+        branched cells of the same state, so no cell-independent level -- the
+        scenario's severity, the natural momentum -- can be learned as, or
+        leak into, a cell's value.
+        """
+        mask = targets["mask"]  # (N, A)
+        count = mask.sum(dim=-1, keepdim=True)
+        valid = (count.squeeze(-1) >= 2.0).to(samples.dtype)
+        safe_count = count.clamp_min(1.0)
+        centered_prediction = samples - (
+            (samples * mask.unsqueeze(1)).sum(dim=-1, keepdim=True) / safe_count.unsqueeze(1)
+        )
+        target = targets["target"]
+        centered_target = target - (target * mask).sum(dim=-1, keepdim=True) / safe_count
+        error = F.smooth_l1_loss(
+            centered_prediction,
+            centered_target.unsqueeze(1).expand_as(centered_prediction),
+            reduction="none",
+            beta=1.0,
+        ) * mask.unsqueeze(1)
+        weight = targets["weight"] * valid.unsqueeze(-1)  # (N, M)
+        denominator = (weight.unsqueeze(-1) * mask.unsqueeze(1)).sum()
+        if float(denominator.detach().item()) <= 0.0:
+            return samples.new_zeros(())
+        return (weight.unsqueeze(-1) * error).sum() / denominator
+
+    @staticmethod
+    def _fpi_auxiliary_loss(outputs: dict, targets: dict) -> torch.Tensor:
+        """World-model supervision from the same branches (WAIT outcome and
+        per-cell physical effects), which shapes the shared representation."""
+        valid = targets["natural_valid"]
+        if float(valid.sum().detach().item()) <= 0.0:
+            return outputs["samples"].new_zeros(())
+        natural_error = F.smooth_l1_loss(
+            outputs["natural"], targets["natural"], reduction="none"
+        ).mean(dim=-1)
+        natural_loss = (natural_error * valid).sum() / valid.sum()
+        cell_mask = targets["mask"] * valid.unsqueeze(-1)  # (N, A)
+        causal = outputs["causal"]  # (N, M, A, 6)
+        effect_error = F.smooth_l1_loss(
+            causal,
+            targets["effect"].unsqueeze(1).expand_as(causal),
+            reduction="none",
+        ).mean(dim=-1)  # (N, M, A)
+        denominator = (cell_mask.sum() * causal.shape[1]).clamp_min(1.0)
+        causal_loss = (effect_error * cell_mask.unsqueeze(1)).sum() / denominator
+        return natural_loss + causal_loss
+
+    def _fpi_evaluate_loss(
+        self, sequences: Sequence[FpiSequence], scales: FPI.FamilyScales
+    ) -> float:
+        """Unweighted within-state loss on held-out episodes (early stopping)."""
+        if not sequences:
+            return float("nan")
+        total, weight = 0.0, 0.0
+        with torch.no_grad():
+            for start in range(0, len(sequences), int(self.nmcc_fpi_minibatch_episodes)):
+                batch = list(sequences[start:start + int(self.nmcc_fpi_minibatch_episodes)])
+                outputs = self._fpi_forward(batch)
+                if not outputs["index"]:
+                    continue
+                targets = self._fpi_targets(batch, outputs["index"], scales, bootstrap=False)
+                cells = float(targets["mask"].sum().item())
+                if cells <= 0.0:
+                    continue
+                loss = float(self._fpi_value_loss(outputs["samples"], targets).item())
+                total += loss * cells
+                weight += cells
+        return total / weight if weight > 0.0 else float("nan")
+
+    def _fpi_refit(
+        self,
+        fit: Sequence[FpiSequence],
+        validation: Sequence[FpiSequence],
+        scales: FPI.FamilyScales,
+    ) -> Dict[str, float]:
+        """Refit the whole network on the label store, with early stopping.
+
+        ``scratch`` restarts from the deterministic initialization every time,
+        so the fitted model is a function of the label set rather than of the
+        order in which labels arrived -- the regime in which held-out gain was
+        observed to grow with data.  ``warm`` continues from the deployed
+        weights.
+        """
+        started = time.perf_counter()
+        policy = self._require_policy()
+        if self.nmcc_fpi_refit_mode == "scratch":
+            policy.load_state_dict(self._build_policy().state_dict(), strict=True)
+        parameters = [parameter for parameter in policy.parameters()]
+        for parameter in parameters:
+            parameter.requires_grad_(True)
+        optimizer = torch.optim.AdamW(
+            parameters,
+            lr=float(self.nmcc_fpi_learning_rate),
+            weight_decay=float(self.nmcc_fpi_weight_decay),
+        )
+        generator = torch.Generator(device="cpu")
+        generator.manual_seed(
+            int(np.random.SeedSequence([self.policy_seed & 0xFFFFFFFF, self.fpi_refits, 0x52454649])
+                .generate_state(1)[0])
+        )
+        has_validation = any(
+            label.branched_count >= 2 for sequence in validation for label in sequence.labels
+        )
+        maximum_epochs = (
+            int(self.nmcc_fpi_refit_max_epochs)
+            if has_validation
+            else min(int(self.nmcc_fpi_refit_max_epochs), int(self.nmcc_fpi_refit_patience))
+        )
+        best_loss = self._fpi_evaluate_loss(validation, scales) if has_validation else float("nan")
+        best_state = copy.deepcopy(policy.state_dict())
+        best_epoch = 0
+        stale = 0
+        epochs = 0
+        steps = 0
+        train_losses: list[float] = []
+        for epoch in range(1, maximum_epochs + 1):
+            epochs = epoch
+            order = torch.randperm(len(fit), generator=generator).tolist()
+            epoch_losses = []
+            for start in range(0, len(order), int(self.nmcc_fpi_minibatch_episodes)):
+                batch = [fit[i] for i in order[start:start + int(self.nmcc_fpi_minibatch_episodes)]]
+                outputs = self._fpi_forward(batch)
+                if not outputs["index"]:
+                    continue
+                targets = self._fpi_targets(batch, outputs["index"], scales, bootstrap=True)
+                value_loss = self._fpi_value_loss(outputs["samples"], targets)
+                loss = value_loss + float(self.nmcc_fpi_auxiliary_loss_coef) * (
+                    self._fpi_auxiliary_loss(outputs, targets)
+                )
+                if not torch.isfinite(loss):
+                    raise FloatingPointError("Fitted-value refit loss became non-finite")
+                if not loss.requires_grad:
+                    # Every state in this minibatch had a single labelled
+                    # cell (no within-state contrast) and no WAIT outcome.
+                    continue
+                optimizer.zero_grad(set_to_none=True)
+                loss.backward()
+                gradient_norm = nn.utils.clip_grad_norm_(parameters, 1.0)
+                if not torch.isfinite(gradient_norm):
+                    raise FloatingPointError("Fitted-value refit gradient became non-finite")
+                optimizer.step()
+                steps += 1
+                epoch_losses.append(float(value_loss.detach().item()))
+            train_losses.append(float(np.mean(epoch_losses)) if epoch_losses else float("nan"))
+            if has_validation:
+                loss_now = self._fpi_evaluate_loss(validation, scales)
+                if np.isfinite(loss_now) and (not np.isfinite(best_loss) or loss_now < best_loss):
+                    best_loss = loss_now
+                    best_state = copy.deepcopy(policy.state_dict())
+                    best_epoch = epoch
+                    stale = 0
+                else:
+                    stale += 1
+                    if stale >= int(self.nmcc_fpi_refit_patience):
+                        break
+            else:
+                best_state = copy.deepcopy(policy.state_dict())
+                best_epoch = epoch
+        policy.load_state_dict(best_state, strict=True)
+        self.optimizer_updates += steps
+        return {
+            "nmcc_fpi_refit_epochs": float(epochs),
+            "nmcc_fpi_refit_best_epoch": float(best_epoch),
+            "nmcc_fpi_refit_train_loss": (
+                float(train_losses[best_epoch - 1]) if best_epoch >= 1 else float("nan")
+            ),
+            "nmcc_fpi_refit_validation_loss": float(best_loss),
+            "nmcc_fpi_refit_seconds": float(time.perf_counter() - started),
+            "nmcc_fpi_refit_steps": float(steps),
+        }
+
+    def _fpi_gate_predictions(
+        self,
+        state_dict: Mapping[str, torch.Tensor],
+        sequences: Sequence[FpiSequence],
+        locations: Sequence[tuple[int, int]],
+        name: str,
+    ) -> FPI.ModelPredictions:
+        """Decision-rule inputs of one set of weights on the gate states."""
+        self._require_policy().load_state_dict(state_dict, strict=True)
+        lookup: dict[tuple[int, int], tuple[np.ndarray, np.ndarray]] = {}
+        batch_size = int(self.nmcc_fpi_minibatch_episodes)
+        with torch.no_grad():
+            for start in range(0, len(sequences), batch_size):
+                positions = list(range(start, min(len(sequences), start + batch_size)))
+                outputs = self._fpi_forward([sequences[i] for i in positions])
+                if not outputs["index"]:
+                    continue
+                samples = outputs["samples"].detach().cpu().numpy().astype(np.float64)
+                prior = outputs["prior"].detach().cpu().numpy().astype(np.float64)
+                for row, (local, label) in enumerate(outputs["index"]):
+                    lookup[(positions[local], label)] = (prior[row], samples[row])
+        prior = np.stack([lookup[location][0] for location in locations])
+        samples = np.stack([lookup[location][1] for location in locations])
+        base = np.asarray(
+            [sequences[episode].labels[label].base_action for episode, label in locations],
+            dtype=np.int64,
+        )
+        mu, sigma = FPI.ensemble_advantage_statistics(samples, base)
+        return FPI.ModelPredictions(name=name, prior=prior, mu=mu, sigma=sigma)
+
+    def _fpi_update(self) -> Dict[str, float]:
+        """One fitted-policy-iteration step: refit on the store, then gate.
+
+        1. Load every committed label; estimate family scales from the fit and
+           validation splits only.
+        2. Refit the network (value ensemble plus world-model auxiliaries) on
+           the fit split with early stopping on the validation split.
+        3. Evaluate the deployed weights (champion) and the refit weights
+           (challenger) on the exhaustive holdout states and deploy the
+           certified candidate with the largest lower bound -- or the base
+           policy if none is certified.  The deployed weights are what the
+           checkpoint stores.
+        """
+        policy = self._require_policy()
+        store = self._fpi_store()
+        fit_episodes = store.load_split("fit", limit=int(self.nmcc_fpi_max_store_episodes))
+        validation_episodes = store.load_split("validation")
+        holdout_episodes = store.load_split("holdout")
+        scales = FPI.family_scales(
+            list(fit_episodes) + list(validation_episodes),
+            prior_strength=float(self.nmcc_fpi_family_prior_strength),
+        )
+        champion_state = copy.deepcopy(policy.state_dict())
+        fit = self._fpi_sequences(store, fit_episodes)
+        validation = self._fpi_sequences(store, validation_episodes)
+        holdout = self._fpi_sequences(store, holdout_episodes)
+        # Evict cached episodes of this store that are no longer in use
+        # (for example beyond nmcc_fpi_max_store_episodes).
+        in_use = {
+            store.frames_path(episode.episode_id)
+            for episode in list(fit_episodes) + list(validation_episodes) + list(holdout_episodes)
+        }
+        for key in list(self._fpi_sequence_cache):
+            if key[0].startswith(store.directory + os.sep) and key[0] not in in_use:
+                del self._fpi_sequence_cache[key]
+        if any(label.branched_count >= 2 for sequence in fit for label in sequence.labels):
+            refit = self._fpi_refit(fit, validation, scales)
+        else:
+            refit = {
+                "nmcc_fpi_refit_epochs": 0.0,
+                "nmcc_fpi_refit_best_epoch": 0.0,
+                "nmcc_fpi_refit_train_loss": float("nan"),
+                "nmcc_fpi_refit_validation_loss": float("nan"),
+                "nmcc_fpi_refit_seconds": 0.0,
+                "nmcc_fpi_refit_steps": 0.0,
+            }
+        challenger_state = copy.deepcopy(policy.state_dict())
+
+        gate_states, locations = FPI.GateStates.from_episodes(holdout_episodes, scales)
+        models: list[FPI.ModelPredictions] = []
+        quality = {"rank_corr": float("nan"), "top1": float("nan"), "prior_top1": float("nan")}
+        if gate_states.states:
+            models.append(self._fpi_gate_predictions(champion_state, holdout, locations, "champion"))
+            models.append(
+                self._fpi_gate_predictions(challenger_state, holdout, locations, "challenger")
+            )
+            challenger = models[-1]
+            quality = FPI.within_state_quality(
+                challenger.mu, gate_states.values, gate_states.feasible, prior=challenger.prior
+            )
+        gate_rng = np.random.default_rng(
+            np.random.SeedSequence([self.policy_seed & 0xFFFFFFFF, self.fpi_refits, 0x47415445])
+        )
+        result = FPI.safe_improvement_gate(
+            gate_states,
